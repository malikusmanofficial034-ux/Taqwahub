<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Prevent all unencrypted cleartext HTTP traffic and enforce strict SSL/TLS HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust pre-installed operating system system certificates only -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
